# Repo root .env.local: read by `npm run db:push` and, as a fallback, by apps/web/scripts/env.mjs.
# Values: Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://<project>.supabase.co
# The publishable (anon) key. It ships in the web bundle, which is fine; RLS guards the data.
SUPABASE_KEY=<anon or publishable key>

# Only for `npm run db:push`. Never put it in an app's env or give it a public prefix.
SUPABASE_DB_PASSWORD=<db-password>

# The mobile app reads its own apps/mobile/.env.local (see apps/mobile/.env.example):
#   EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_KEY
