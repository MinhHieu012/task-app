# Copy to .env.local and fill from Supabase Dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<anon or publishable key>

# Only for `npm run db:push` (never prefix with EXPO_PUBLIC_, they would ship in the app).
# The database password set when creating the project.
SUPABASE_DB_PASSWORD=<db-password>
