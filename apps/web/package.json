{
  "name": "task-app-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env": "node scripts/env.mjs",
    "prestart": "node scripts/env.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/env.mjs",
    "build": "ng build",
    "build:staging": "node scripts/env.mjs && ng build --configuration staging",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/env.mjs",
    "test": "ng test --watch=false",
    "test:core": "node ../../packages/core/src/logic.check.ts",
    "lint": "ng lint",
    "typecheck": "node scripts/env.mjs && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\"",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:core"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "lucide": "^1.72.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.65.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.0.8"
  }
}
